rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // upload_tes folder — open read/write for uploading and downloading files
    match /upload_tes/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
