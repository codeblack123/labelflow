rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // upload_tes_history collection — read/write for all authenticated & anonymous users
    // Since this app doesn't use Firebase Auth, we allow open access.
    // For production, consider adding Firebase Auth and restricting by user.
    match /upload_tes_history/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false; // Documents are immutable once created
      allow delete: if false; // Prevent accidental deletion from client
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
